---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
---

<Base>
  <main class="view" data-view>
    <div class="world" data-world>
      <Hero />
    </div>

    <!-- cobalt flood: grows out of the portal dot -->
    <div class="flood" data-flood aria-hidden="true"></div>
    <p class="flood__label mono" data-flood-label aria-hidden="true">Stage 02 — About</p>

    <!-- About lives in its own perspective world, revealed by an iris -->
    <div class="about-clip" data-about-clip>
      <div class="about-world" data-about-world>
        <About />
        <!-- Stage 03+ mounts here as another .stage sibling. -->
      </div>
    </div>
  </main>

  <Preloader />
</Base>

<script>
  import { boot } from '../scripts/engine';
  boot();
</script>
