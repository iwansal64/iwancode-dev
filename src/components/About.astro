---
import { content } from "../data/content";
const { about, hud } = content;
---

<section class="stage about on-ink" id="about" data-stage="about" aria-labelledby="about-title">
        <canvas class="about__contours" data-contours aria-hidden="true"></canvas>
        <div class="about__grid-bg" data-arrive="0"></div>

        <div class="about__scroll" data-about-scroll>
                <p class="about__eyebrow mono" data-arrive="1">
                        <span>Developer profile — character identity</span>
                </p>

                <h2 class="about__head" id="about-title" data-arrive="2">
                        <span class="line"
                                ><span data-about-line>
                                        {about.headline.before}<span class="serif-em">{about.headline.em}</span>{about.headline.after}
                                </span></span
                        >
                </h2>

                <div class="about__col about__body" data-arrive="3">
                        I started programming because I love games and technology. Every challenge, every steep road ahead, every stuck moment, every bug, those are what make programming worth
                        learning. What kept me here is the feeling of making something real out of our own creativity and stubbornly putting concentration on something we care for
                </div>

                <aside class="about__aside" data-arrive="4">
                        <figure class="portrait" aria-label="Portrait placeholder">
                                <span class="portrait__cross"></span>
                                <span class="portrait__tick"></span>
                                <figcaption class="portrait__label mono">
                                        <span>{about.portraitLabel}</span><span>01 / 01</span>
                                </figcaption>
                        </figure>

                        <!--
        EXTENSION POINT — Stage 03+
        Unlock by: (1) adding { id, label } to content.stages,
        (2) creating the component + mounting it in index.astro,
        (3) appending one segment in src/scripts/dive.ts (STAGE_SEGMENTS).
      -->
                        <p class="about__locked mono" data-locked>
                                <span>{hud.locked}</span><span class="cobalt">■ 03</span>
                        </p>
                </aside>

                <dl class="about__stats" data-arrive="5">
                        {
                                about.stats.map((s, i) => (
                                        <div class="stat" data-stat>
                                                <dt class="stat__k mono">
                                                        {String(i + 1).padStart(2, "0")} · {s.key}
                                                </dt>
                                                <dd class="stat__v" style="margin:0" data-stat-v>
                                                        {s.key === "Status" && <span class="dot" aria-hidden="true" />}
                                                        {s.value}
                                                </dd>
                                        </div>
                                ))
                        }
                </dl>

                <button class="about__back" type="button" data-back data-cursor-hover="BACK" data-arrive="6">
                        <span class="arrow" aria-hidden="true">↑</span>{content.backLabel}
                </button>
        </div>
</section>
